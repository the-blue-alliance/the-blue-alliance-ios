default_platform :ios

# Release only. Everything a developer runs locally - tests, formatting,
# linting, version bumps - lives in the Makefile at the repo root, and CI calls
# those same targets. These lanes only ever run from .github/workflows/release.yml.

# Failure messages worth translating into the actual next step, since fastlane's
# own output either buries the cause or can't explain it.
KNOWN_FAILURE_HINTS = [
  {
    match: /ProgramLicenseAgreementUpdated|required agreement is missing or has expired/i,
    hint: "An App Store Connect agreement is unsigned or expired. The Account Holder has to accept it at https://appstoreconnect.apple.com/agreements, then re-run this workflow."
  },
  {
    match: /UnauthorizedAccessError|NoUserCredentialsError|Authentication credentials are missing or invalid/i,
    hint: "App Store Connect rejected our API key. Check that the APPLE_KEY_ID, APPLE_ISSUER_ID, and APPLE_KEY_CONTENT secrets are current and that the key is still active under Users and Access > Integrations."
  },
  {
    match: /InsufficientPermissions/,
    hint: "Our App Store Connect API key doesn't have the access this lane needs. It has to be an App Manager (or Admin) key under Users and Access > Integrations."
  },
  {
    match: /Error building the application|Exit status: 65/,
    hint: "The archive failed to build. xcpretty hides the real compiler error, so download the build-logs artifact from this run for the full xcodebuild log. Release builds with optimizations that CI's Debug test run does not, so this can fail while CI is green."
  }
].freeze

RELEASE_LANES = [:beta_ci, :app_store].freeze
RELEASE_CHANNEL = "#app-releases".freeze
RELEASE_BOT_ICON_URL = "https://raw.githubusercontent.com/the-blue-alliance/the-blue-alliance-logo/master/ios/tba-icon-60%403x.png".freeze

platform :ios do

  ## Release Lanes ##

  desc "Configure code signing"
  private_lane :configure_code_signing do
    if is_ci?
      match(
        git_url: "#{ENV["MATCH_GIT_REPO"]}",
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"],
        app_identifier: ["com.the-blue-alliance.tba"]
      )
    else
      match(
        app_identifier: ["com.the-blue-alliance.tba"]
      )
    end
  end

  desc "Upload a new beta build to TestFlight (for CI machine)"
  lane :beta_ci do
    setup_api
    prebeta
    build

    slack(channel: "#github-ios", message: "Shipping #{current_git_tag} to TestFlight...", default_payloads: [])
    pilot(changelog: commit_changelog, distribute_external: true, groups: ["Beta"], reject_build_waiting_for_review: true)
    slack(
      channel: "#github-ios",
      message: "#{current_git_tag} uploaded to TestFlight 🎉",
      default_payloads: []
    )
  end

  desc "Upload a new build to the App Store"
  lane :app_store do
    setup_api
    preship
    build

    release_body = generated_release_notes
    ship_github(is_prerelease: false, description: release_body)
    slack(
      channel: RELEASE_CHANNEL,
      message: "Shipping iOS #{current_version} to the App Store 🎉\n```\n#{release_body}\n```\nhttps://github.com/the-blue-alliance/the-blue-alliance-ios/releases/tag/#{current_version}",
      default_payloads: [],
      username: "release-bot",
      icon_url: RELEASE_BOT_ICON_URL,
      attachment_properties: {}
    )
    deliver(
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  private_lane :ship_github do |options|
   set_github_release(
     repository_name: "the-blue-alliance/the-blue-alliance-ios",
     api_token: ENV["GH_TOKEN"],
     name: current_version,
     tag_name: current_version,
     description: options[:description],
     is_prerelease: options[:is_prerelease] ? true : false,
     upload_assets: ["The Blue Alliance.ipa"]
   )
 end

  ## End Release Lanes ##

  ## Shipping Lanes for Release Lanes ##

  desc "Setup App Store Connect API Key"
  private_lane :setup_api do
    app_store_connect_api_key(
      key_id: ENV["APPLE_KEY_ID"],
      issuer_id: ENV["APPLE_ISSUER_ID"],
      key_content: ENV["APPLE_KEY_CONTENT"]
    )
  end

  desc "Perform pre-TestFlight tasks"
  private_lane :prebeta do
    # Bump our build number for TestFlight
    testflight_build_number = latest_testflight_build_number(
      app_identifier: "com.the-blue-alliance.tba",
      version: get_version_number(target: "The Blue Alliance"),
      initial_build_number: 0
    )
    increment_build_number(build_number: testflight_build_number + 1)
  end

  desc "Perform pre-App Store tasks"
  private_lane :preship do
    # Bump our build number based on the latest TestFlight build for this version
    testflight_build_number = latest_testflight_build_number(
      app_identifier: "com.the-blue-alliance.tba",
      version: get_version_number(target: "The Blue Alliance"),
      initial_build_number: 0
    )
    increment_build_number(build_number: testflight_build_number + 1)
  end

  desc "Perform codesign/build tasks"
  private_lane :build do
    configure_code_signing
    update_project_team(teamid: ENV["sigh_com.the-blue-alliance.tba_appstore_team-id"])
    update_project_provisioning(
      profile: ENV["sigh_com.the-blue-alliance.tba_appstore_profile-path"],
      target_filter: "The Blue Alliance",
      build_configuration: "Release",
      code_signing_identity: "iPhone Distribution"
    )
    gym(buildlog_path: "logs")
    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: "the-blue-alliance-ios/GoogleService-Info.plist"
    )
  end

  ## End Shipping Lanes for Release Lanes ##

  ## Internal Lanes for Shipping Lanes ##

  private_lane :current_git_tag do
    "#{current_version}b#{get_build_number}"
  end

  private_lane :current_version do
    "v#{get_version_number(target: "The Blue Alliance")}"
  end

  private_lane :commit_changelog do
    File.read("release_notes/beta.md").strip
  end

  private_lane :generated_release_notes do
    notes = github_api(
      api_token: ENV["GH_TOKEN"],
      http_method: "POST",
      path: "/repos/the-blue-alliance/the-blue-alliance-ios/releases/generate-notes",
      body: {
        tag_name: current_version,
        target_commitish: "main"
      }
    )
    notes[:json]["body"]
  end

  ## End Internal Lanes for Shipping Lanes ##

  ## Error Handling ##

  # Reporting only - fastlane re-raises after this, so it never swallows a failure.
  error do |lane, exception, options|
    known_error = KNOWN_FAILURE_HINTS.find do |candidate|
      "#{exception.class} #{exception.message}" =~ candidate[:match]
    end
    hint = known_error && known_error[:hint]

    if hint
      UI.error("👉 #{hint}")
      # Beats the default "Process completed with exit code 1" annotation.
      puts("::error title=fastlane #{lane} needs a human::#{hint}") if ENV["GITHUB_ACTIONS"]
    end

    next unless RELEASE_LANES.include?(lane)
    next if ENV["SLACK_URL"].to_s.empty?

    run_url = ENV["GITHUB_RUN_ID"] ? "\n#{ENV["GITHUB_SERVER_URL"]}/#{ENV["GITHUB_REPOSITORY"]}/actions/runs/#{ENV["GITHUB_RUN_ID"]}" : ""

    slack(
      channel: RELEASE_CHANNEL,
      # Not echoing exception.message - match/sigh failures can carry repo URLs
      # and keychain details.
      message: "iOS release failed 🚨 (`fastlane #{lane}`)\n#{hint || "Check the build log for details."}#{run_url}",
      success: false,
      default_payloads: [],
      username: "release-bot",
      icon_url: RELEASE_BOT_ICON_URL,
      fail_on_error: false # a Slack hiccup shouldn't mask the real error
    )
  end

  ## End Error Handling ##

end
