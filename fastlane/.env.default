# `xcodebuild -showBuildSettings` is dominated by SwiftPM resolution, so it's
# network-bound and varies a lot: we've measured anywhere from 107s to 214s on a
# cold CI runner. Fastlane gives up after 3s by default, which breaks gym. A
# generous ceiling costs nothing when the command returns quickly. Set here
# rather than per workflow so every lane gets it. Dotenv won't override an
# existing env var.
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=300
